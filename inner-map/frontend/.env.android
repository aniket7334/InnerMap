# Android app (Capacitor) build: `npm run build:android` (vite build --mode android).
# Inside the app, "/" is the app itself, so the Inner Map server needs a full address that the
# phone can reach from any network: the hosted backend on Render.
# (For testing against this PC instead: http://<PC Wi-Fi IP>:5000, phone on the same Wi-Fi.)
VITE_API_URL=https://inner-map-backend.onrender.com/api
VITE_VECTOR_TILE_URL=https://inner-map-backend.onrender.com/tiles/vector/{z}/{x}/{y}.mvt
VITE_VECTOR_METADATA_URL=https://inner-map-backend.onrender.com/tiles/vector/metadata
VITE_GLOBE_DATA_URL=https://inner-map-backend.onrender.com/globe-data
