{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://inner-map-backend.onrender.com/api/:path*" },
    { "source": "/tiles/:path*", "destination": "https://inner-map-backend.onrender.com/tiles/:path*" },
    { "source": "/globe-data/:path*", "destination": "https://inner-map-backend.onrender.com/globe-data/:path*" },
    {
      "source": "/((?!api/|tiles/|globe-data/|cesium/|assets/|data/|icons/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/cesium/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
