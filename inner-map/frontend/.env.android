# Android app (Capacitor) build: `vite build --mode android`.
# Inside the app, "/" is the app itself, so the Inner Map server needs a full address that the
# phone can reach. For testing: this PC on the same Wi-Fi (change the IP if it changes; allow
# Node.js through Windows Firewall on private networks). Later: your public server.
VITE_API_URL=http://10.90.21.146:5000/api
VITE_VECTOR_TILE_URL=http://10.90.21.146:5000/tiles/vector/{z}/{x}/{y}.mvt
VITE_VECTOR_METADATA_URL=http://10.90.21.146:5000/tiles/vector/metadata
VITE_GLOBE_DATA_URL=http://10.90.21.146:5000/globe-data
