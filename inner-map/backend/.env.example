# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of front-end origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- MySQL (XAMPP defaults: user root, empty password) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inner_map_db

# ---- JWT ----
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Self-hosted tiles (optional) ----
# Folder with {z}/{x}/{y}.png tiles served at /tiles. Relative to backend/.
TILES_DIR=tiles

# ---- Offline vector basemap (PMTiles archive, see data/README.md) ----
VECTOR_TILES_FILE=data/mumbai.pmtiles

# ---- Routing (directions) ----
# Online provider: osrm (default: FOSSGIS servers at routing.openstreetmap.de - max 1 request/s,
#   light use only; run your own OSRM for production and set OSRM_*_URL), graphhopper (needs a key),
#   or local (Inner Map's own router over ROUTING_GRAPH_FILE; no external service, limited area).
ROUTING_PROVIDER=osrm
OSRM_CAR_URL=
OSRM_BIKE_URL=
OSRM_FOOT_URL=
# Only if you run an OSRM server built with a motorcycle profile (the public FOSSGIS servers have none).
# Without it, motorcycle routes use Inner Map's own router inside its road data, else a marked car route.
OSRM_MOTORCYCLE_URL=
GRAPHHOPPER_API_KEY=
# Road graph for offline routing, built with: node scripts/build-routing-graph.mjs (see data/README.md)
ROUTING_GRAPH_FILE=data/mumbai.routing.json.gz
