# =====================================================================
#  Inner Map front-end configuration (Vite reads VITE_* variables)
#  Copy to .env and restart `npm run dev` (or rebuild) after changing anything.
# =====================================================================

# ---- Map providers (see src/maps/providers.js) -------------------------
# Built-in providers:
#   local-vector  "Inner Map Offline" - OpenStreetMap vector data served by the
#                 Inner Map backend from backend/data/*.pmtiles. Downloadable.
#   osm-standard  openstreetmap.org tiles. Online browsing only (its usage policy
#                 forbids offline/bulk downloads, so downloads are blocked).
VITE_DEFAULT_PROVIDER=local-vector

# Where the vector tiles come from. Leave as-is when using the Vite proxy.
VITE_VECTOR_TILE_URL=/tiles/vector/{z}/{x}/{y}.mvt
VITE_VECTOR_METADATA_URL=/tiles/vector/metadata

# ---- Optional extra raster provider ("custom-raster") -------------------
# Leave VITE_TILE_URL empty unless you have your own raster tiles, e.g. a QGIS
# export in backend/tiles served at /tiles/{z}/{x}/{y}.png, or a licensed provider.
# Set VITE_TILE_OFFLINE_ALLOWED=true ONLY if that source permits offline storage.
# Public servers that forbid bulk downloads (openstreetmap.org, Google) are ignored here.
VITE_TILE_URL=
VITE_TILE_LABEL=Custom raster tiles
VITE_TILE_SUBDOMAINS=
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
VITE_TILE_MIN_ZOOM=0
VITE_TILE_MAX_ZOOM=19
VITE_TILE_OFFLINE_ALLOWED=false

# ---- Download limits (be polite to your tile server) -------------------
VITE_MAX_TILES_PER_DOWNLOAD=30000
VITE_DOWNLOAD_CONCURRENCY=4

# ---- Place search (used on the Download page) ----------------------------
# Nominatim's public instance allows light, interactive use (max 1 request/second,
# no autocomplete). Inner Map only searches when you press "Search".
VITE_GEOCODER_URL=https://nominatim.openstreetmap.org/search

# ---- API --------------------------------------------------------------
# Leave as /api when using the Vite proxy (recommended).
VITE_API_URL=/api
